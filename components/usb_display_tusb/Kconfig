menu "USB Extended Display"

    config USB_DISPLAY_VID
        hex "USB Vendor ID"
        default 0x303A

    config USB_DISPLAY_PID
        hex "USB Product ID"
        default 0x4001

    config USB_DISPLAY_MANUFACTURER
        string "USB Manufacturer string"
        default "ESPHome"

    config USB_DISPLAY_PRODUCT
        string "USB Product string"
        default "udisp"

    config USB_DISPLAY_SERIAL
        string "USB Serial string"
        default "0001"

    config USB_DISPLAY_HIGH_SPEED
        bool "Use the High-Speed USB peripheral"
        default y
        help
            Sets the vendor endpoint packet size to 512 instead of 64. The
            ESP32-P4's internal PHY is High-Speed; only turn this off for a
            board wired to the Full-Speed pins.

    config USB_DISPLAY_SENDER_DRIVE
        bool "Carry the host sender on a read-only drive"
        default y
        help
            Adds a mass-storage interface holding the program the PC has to run
            to send its screen, so it arrives with the board instead of being
            downloaded. Windows binds its own driver to it; no installation.

            Turn this off to go back to a single-interface device.

endmenu
